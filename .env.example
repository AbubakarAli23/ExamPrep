# ExamPrep configuration — copy to .env and fill in your own values.
# Never commit a real key or password.

# Google Gemini Developer API key (required for study generation and the tutor).
GOOGLE_API_KEY=

# Gemini model. Must be a model your API key can access.
GEMINI_MODEL=gemini-3.8-flash

# PostgreSQL connection
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/examprep
SPRING_DATASOURCE_USERNAME=examprep
SPRING_DATASOURCE_PASSWORD=change-me

# Where uploaded documents are stored (must stay outside the web root)
APP_STORAGE_LOCATION=./data/uploads

# Upload limit in megabytes
APP_MAX_UPLOAD_SIZE_MB=25

# HTTP port
SERVER_PORT=8080

# Optional tuning
GEMINI_REQUEST_TIMEOUT_SECONDS=150
GEMINI_MAX_RETRIES=2
GEMINI_MAX_OUTPUT_TOKENS=16384
TUTOR_CONTEXT_CHUNKS=6
APP_STALE_JOB_MINUTES=30
